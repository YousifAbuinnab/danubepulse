POSTGRES_DB=danubepulse
POSTGRES_USER=danubepulse
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
DATA_MODE=demo
BRONZE_DIR=./data/bronze
LOG_LEVEL=INFO
# Generate a local demo-action token with scripts/setup_demo_control.py.
DEMO_CONTROL_TOKEN=
# Optional Airflow profile: generate the three secrets with scripts/setup_airflow.py.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
#
# Optional ENTSO-E API access; obtain approval before configuring.
ENTSOE_API_TOKEN=
ENTSOE_TERMS_ACCEPTED=false
# A65 uses a separate one-run --accept-load-forecast-terms review, not the general gate.
